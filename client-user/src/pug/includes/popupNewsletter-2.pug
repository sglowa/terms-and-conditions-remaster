extends popupFrame.pug
block vars
	-var height = "auto"
	-var width = "80%"
	-var closeContainer='close-container-2'
	-var id="popup-newsletter-2"
block title
	h1.popup-title.m-0.mt-2 Subscribe
block content
	span.popup-text.px-4.mb-2.overflow-auto.flex-grow-1
		h2.form-call2action.mt-2
			| To be updated with all the latest news! Join!
		form.mt-2
			.form-group.mt-4
				-var inputData = {label:'newsletter2',placeholder:'type your E-MAIL address here',type:'email',id:`${id}_email`,label_hidden:'d-none'}
				include textInput.pug
	- var btnLeft = "No, thanks";
	- var btnRight = "YES";
	- var btnInnerMrgn = "my-0";
	.px-5.pt-4
		include twoBtns-aligned.pug
	.popup-foooter-spacer.pb-4