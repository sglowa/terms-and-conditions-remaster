//- VARS:
//- var id
//- var btnLeft
//- var btnRight
//- var btnInnerMrgn
.btnsContainer.btn-toolbar.justify-content-between
	.btn-no.d-flex(style="width: 40%; max-width:200px")
		button.btn-secondary.flex-grow-1.text-nowrap.pb-0.pt-1(
			x-on:click!=`$store['${id}-hasBeenResolved']=true`
		)
			h4.btn-text.text-center(class=`${btnInnerMrgn}`)= btnLeft
	.gutter.flex-shrink-1(style="width:10%;")
	.btn-yes.d-flex(style="width: 40%; max-width:200px")
		button.btn-primary.flex-grow-1.text-nowrap.pb-0.pt-1(			
			disabled="true"			
			x-bind:disabled= `typeof areAllConditionsSatisfied !== 'undefined' 
				? !areAllConditionsSatisfied 
				: true`
			x-on:click!=`$store['${id}-hasBeenResolved']=true`
		)
			h4.btn-text.text-center(class=`${btnInnerMrgn}`)= btnRight
//- x-init="if (typeof condition_met == 'undefined') condition_met = true"