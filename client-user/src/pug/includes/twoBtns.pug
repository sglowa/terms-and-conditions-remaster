.btnsContainer.btn-toolbar.justify-content-center
	.btn-no.d-flex.w-25(style="max-width:100px")
		button.btn-secondary.flex-grow-1.text-nowrap.py-0
			p.btn-text.text-center(class=`${btnInnerMrgn}`)= btnLeft
	.gutter.flex-shrink-1(style="width:10%;")
	.btn-yes.d-flex.w-25(style="max-width:100px")
		button.btn-primary.flex-grow-1.text-nowrap.py-0
			p.btn-text.text-center(class=`${btnInnerMrgn}`)= btnRight