block vars
.bg-layer.position-absolute.w-100.h-100(id=`${id}-bglayer`)
.popup-frame.d-flex.flex-column-reverse.position-absolute(
	id=`${id}`
	style=`
		height:${height};
		width:${width};
		${extraFrameStyle ? extraFrameStyle : ''}
	`
	should-activate = shouldActivate == undefined ? true : shouldActivate
	should-reposition = shouldReposition == undefined ? true : shouldReposition
)
	.popup-body.d-flex.flex-column.flex-grow-1.bg-secondary.border-primary(style="border:3.5px solid;overflow-y:clip")
		.close-btn.align-self-end(class=`${closeContainer}`)
			img.close-img(src="/assets/x.svg" style='height: 1rem;width: 1rem;')
		block content
	.popup-title.m-0
		block title