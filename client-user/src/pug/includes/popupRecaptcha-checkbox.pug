.bg-layer.position-absolute.w-100.h-100(id=`fkrc-checkbox-wrapper-${idNum}-bglayer`)
.fkrc.fkrc-checkbox-wrapper.position-absolute(id=`fkrc-checkbox-wrapper-${idNum}` should-reposition should-activate)
	.fkrc-container.fkrc-m-p
		.fkrc-checkbox-window.fkrc-m-p.fkrc-block
			.fkrc-checkbox-container.fkrc-m-p
				button.fkrc-checkbox.fkrc-m-p.fkrc-line-normal(type='button')
			p.fkrc-im-not-a-robot.fkrc-m-p.fkrc-line-normal I&apos;m not a robot
			img.fkrc-captcha-logo.fkrc-line-normal(src='/assets/fakerecaptcha/captcha_logo.svg' alt='')
			p.fkrc-checkbox-desc.fkrc-m-p.fkrc-line-normal CAPTCHA
			p.fkrc-checkbox-desc.fkrc-m-p.fkrc-line-normal Privacy - Terms
			img.fkrc-spinner.fkrc-m-p.fkrc-line-normal(src='/assets/fakerecaptcha/captcha_spinner.gif' alt='')